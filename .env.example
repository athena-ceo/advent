# Copy to .env and fill in. Read automatically by `docker compose` / ./advent.sh.

# Required for the natural-language "Guided" mode (Classic mode needs no key).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADVENT_LLM_MODEL=claude-opus-5

# Ports (optional; defaults shown). Distinct from golden-path (8020/3020) and
# xcape (8030/3030).
BACKEND_PORT=8040
FRONTEND_PORT=3040

# Where to persist the lazy scene-image cache on the host (optional).
ADVENT_SCENE_CACHE_HOST=./scene-cache
