# Copyright (c) 2026 Athena Decisions Systems SAS.
# Copy to .env and fill in. Read automatically by `docker compose` / ./advent.sh.

# Required for the natural-language "Guided" mode (Classic mode needs no key).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADVENT_LLM_MODEL=claude-opus-5

# Admin panel password (X-Advent-Admin). Leave blank to disable the admin API.
ADVENT_ADMIN_PASSWORD=change-me

# Ports (optional; defaults shown). Distinct from golden-path (8020/3020) and
# xcape (8030/3030).
BACKEND_PORT=8040
FRONTEND_PORT=3040

# Where to persist the image caches on the host (optional; defaults shown).
# scene-cache and sprite-cache are pre-generated on a GPU/MPS box and rsynced up
# (see `./advent.sh sync prod`); composite-cache is derived on the server.
ADVENT_SCENE_CACHE_HOST=./scene-cache
ADVENT_SPRITE_CACHE_HOST=./sprite-cache
ADVENT_COMPOSITE_CACHE_HOST=./composite-cache

# For `./advent.sh sync prod` -- push the local image banks to the prod host.
# Runs from your dev machine and pushes up over SSH. ADVENT_DEPLOY_DIR is the
# checked-out repo directory on the server (siblings live under ~/projects).
ADVENT_DEPLOY_SSH=harley@apps.athenadecisions.com
ADVENT_DEPLOY_DIR=/home/harley/projects/advent
